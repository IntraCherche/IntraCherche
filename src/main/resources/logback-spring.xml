<configuration>

    <!-- Read settings from application.yaml.
         <springProperty> requires logback-spring.xml (Spring Boot extended variant). -->
    <springProperty name="auditRetentionDays" source="audit.retention-days" defaultValue="365"/>
    <!-- Fixed log location for the systemd service (provisioned and owned by the
         intracherche user in install.sh). Not user-configurable by design. -->
    <property name="LOG_DIR" value="/var/log/intracherche"/>
    <springProperty name="LOG_MAX_HISTORY"   source="logging.logback.rollingpolicy.max-history"  defaultValue="30"/>
    <springProperty name="LOG_MAX_FILE_SIZE" source="logging.logback.rollingpolicy.max-file-size" defaultValue="10MB"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Legal audit log: append-only, daily rotation, configurable retention -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/audit.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/audit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${auditRetentionDays}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} | %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- AUDIT logger: dedicated, never mixed with application logs -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="APP_FILE"/>
    </root>

    <logger name="org.apache.tika" level="WARN"/>
    <logger name="org.apache.pdfbox" level="ERROR"/>
    <logger name="org.apache.solr" level="WARN"/>
    <logger name="com.hierynomus" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>

</configuration>
